{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "paths": {
      "#astrale-ui/class-name": ["./src/class-name.ts"],
      "#astrale-ui/icon": ["./src/icon/index.tsx"],
      "#astrale-ui/*": ["./src/*/index.tsx", "./src/*/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
