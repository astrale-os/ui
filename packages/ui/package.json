  "scripts": {
    "clean": "node ../../scripts/clean-ui.mjs",
    "build": "pnpm run clean && tsc && pnpm exec tailwindcss -i src/theme/theme.css -o dist/theme.css --minify && node ../../scripts/copy-ui-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepack": "pnpm run build"
  },
