{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "#actions": ["./actions/index.ts"],
      "#actions/*": ["./actions/*/index.ts"],
      "#integrations": ["./integrations/index.ts"],
      "#integrations/*": ["./integrations/*/index.ts"],
      "#migrations": ["./migrations/index.ts"],
      "#migrations/*": ["./migrations/*/index.ts"],
      "#mutations": ["./mutations/index.ts"],
      "#mutations/*": ["./mutations/*/index.ts"],
      "#queries": ["./queries/index.ts"],
      "#queries/*": ["./queries/*/index.ts"],
      "#routes": ["./routes/index.ts"],
      "#routes/*": ["./routes/*/index.ts"],
      "#providers": ["./providers/index.ts"],
      "#providers/*": ["./providers/*/index.ts"],
      "#rules": ["./rules/index.ts"],
      "#rules/*": ["./rules/*/index.ts"],
      "#schema": ["./schema/index.ts"],
      "#schema/*": ["./schema/*/index.ts"],
      "#scripts": ["./scripts/index.ts"],
      "#scripts/*": ["./scripts/*/index.ts"],
      "#states": ["./states/index.ts"],
      "#states/*": ["./states/*/index.ts"],
      "#tests": ["./tests/index.ts"],
      "#tests/*": ["./tests/*/index.ts"],
      "#ui": ["./ui/index.ts"],
      "#ui/*": ["./ui/*/index.ts"],
      "#utils": ["./utils/index.ts"],
      "#utils/*": ["./utils/*/index.ts"],
      "#views": ["./views/index.ts"],
      "#views/*": ["./views/*/index.ts"],
      "#workflows": ["./workflows/index.ts"],
      "#workflows/*": ["./workflows/*/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "schema",
    "states",
    "rules",
    "queries",
    "routes",
    "mutations",
    "workflows",
    "migrations",
    "actions",
    "integrations",
    "providers",
    "utils",
    "scripts",
    "tests",
    "application.ts",
    "runtime.ts",
    "index.ts",
    "astrale.config.ts"
  ],
  "exclude": ["node_modules", ".dist", ".wrangler", "**/dist"]
}
