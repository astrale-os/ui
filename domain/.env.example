# Secrets for an Environment live in the file its `secrets:` names in astrale.config.ts
# (.env.dev for development, .env.prod for production). The ENTIRE file is treated as
# secrets: a deploy binds their current values to the new deployment it makes, and
# redeploying the identical release rewrites that deployment's secrets in place. These
# files are gitignored — copy this to `.env.dev` and fill in.
#
# Add one line per secret required by an Integration. Declare the corresponding
# binding returned by `runtime.ts` initialization. For example:
#
# EXAMPLE_API_KEY=sk-...

# Each deployment signs with a key generated for it when it is deployed: there is no
# identity file to retain, and no key belongs in this dotenv file.

GITHUB_TOKEN=
GITHUB_OWNER=astrale-os
GITHUB_REPOSITORY=ui
GITHUB_ACTOR=
