{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattern-command-command-10",
  "title": "Command 10",
  "description": "Keyboard-triggered (⌘J) search palette with Suggestions, timestamped Recent items, Quick Links, and a navigation hint footer.",
  "dependencies": [
    "@astrale-os/ui@^0.3.0-beta.0",
    "lucide-react@1.32.0",
    "react@19.2.8"
  ],
  "files": [
    {
      "path": "source/patterns/command/command-10/command-10.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { Button } from '@astrale-os/ui/button'\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator\n} from '@astrale-os/ui/command'\nimport { Kbd } from '@astrale-os/ui/kbd'\nimport { SearchIcon, SparkleIcon, ComponentIcon, BlocksIcon, LayoutTemplateIcon, PaletteIcon, ClockIcon, BookOpenIcon, LifeBuoyIcon, MessageSquareIcon, Undo2Icon, ArrowUpIcon, ArrowDownIcon } from \"lucide-react\"\n\nconst CommandSearch = () => {\n  const [open, setOpen] = React.useState(false)\n\n  React.useEffect(() => {\n    const down = (event: KeyboardEvent) => {\n      if (event.key === 'j' && (event.metaKey || event.ctrlKey)) {\n        event.preventDefault()\n        setOpen(open => !open)\n      }\n    }\n\n    document.addEventListener('keydown', down)\n\n    return () => document.removeEventListener('keydown', down)\n  }, [])\n\n  return (\n    <div className='flex flex-col gap-4'>\n      <Button onClick={() => setOpen(true)} variant='outline' className='w-52'>\n        <SearchIcon className='size-4' />\n        Search files...\n        <Kbd className='ml-auto'>⌘J</Kbd>\n      </Button>\n      <CommandDialog open={open} onOpenChange={setOpen} className='w-full max-w-lg!'>\n        <Command>\n          <CommandInput placeholder='Type a command or search...' />\n          <CommandList>\n            <CommandEmpty>No results found.</CommandEmpty>\n            <CommandGroup heading='Suggestions'>\n              <CommandItem>\n                <SparkleIcon\n                />\n                <span>Introduction</span>\n              </CommandItem>\n              <CommandItem>\n                <ComponentIcon\n                />\n                <span>Components</span>\n              </CommandItem>\n              <CommandItem>\n                <BlocksIcon\n                />\n                <span>Blocks</span>\n              </CommandItem>\n              <CommandItem>\n                <LayoutTemplateIcon\n                />\n                <span>Templates</span>\n              </CommandItem>\n              <CommandItem>\n                <PaletteIcon\n                />\n                <span>Theme Generator</span>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading='Recent'>\n              <CommandItem>\n                <ClockIcon className='text-muted-foreground' />\n                <span>Dashboard Analytics</span>\n                <div className='ml-auto' data-slot='command-shortcut'>\n                  <span>2m ago</span>\n                </div>\n              </CommandItem>\n              <CommandItem>\n                <ClockIcon className='text-muted-foreground' />\n                <span>User Settings</span>\n                <div className='ml-auto' data-slot='command-shortcut'>\n                  <span>15m ago</span>\n                </div>\n              </CommandItem>\n              <CommandItem>\n                <ClockIcon className='text-muted-foreground' />\n                <div className='flex flex-1 items-center justify-between'>\n                  <span>Team Members</span>\n                  <div className='ml-auto' data-slot='command-shortcut'>\n                    <span>1h ago</span>\n                  </div>\n                </div>\n              </CommandItem>\n              <CommandItem>\n                <ClockIcon className='text-muted-foreground' />\n                <span>Billing & Plans</span>\n                <div className='ml-auto' data-slot='command-shortcut'>\n                  <span>2h ago</span>\n                </div>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading='Quick Links'>\n              <CommandItem>\n                <BookOpenIcon\n                />\n                <span>Documentation</span>\n              </CommandItem>\n              <CommandItem>\n                <LifeBuoyIcon\n                />\n                <span>Help & Support</span>\n              </CommandItem>\n              <CommandItem>\n                <MessageSquareIcon\n                />\n                <span>Contact Us</span>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n          <CommandSeparator />\n          <div className='text-muted-foreground flex flex-wrap items-center gap-4 p-4'>\n            <div className='flex flex-1 items-center gap-2'>\n              <kbd className='rounded border px-1 text-sm'>esc</kbd>\n              <span>To close</span>\n            </div>\n            <div className='flex items-center gap-2'>\n              <div className='flex size-5 items-center justify-center rounded border'>\n                <Undo2Icon className='size-4' />\n              </div>\n              <span>To Select</span>\n            </div>\n            <div className='flex items-center gap-2'>\n              <div className='flex size-5 items-center justify-center rounded border'>\n                <ArrowUpIcon className='size-4' />\n              </div>\n              <div className='flex size-5 items-center justify-center rounded border'>\n                <ArrowDownIcon className='size-4' />\n              </div>\n              <span>To Navigate</span>\n            </div>\n          </div>\n        </Command>\n      </CommandDialog>\n    </div>\n  )\n}\n\nexport default CommandSearch\n",
      "type": "registry:component",
      "target": "components/astrale/pattern/command/command-10.tsx"
    }
  ],
  "meta": {
