{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-communication-inbox",
  "title": "Block · Communication · Inbox",
  "description": "Astrale block/communication/inbox; controlled application responsibilities are injected through props.",
  "dependencies": [
    "@astrale-os/ui@^0.3.0"
  ],
  "files": [
    {
      "path": "registry/blocks/communication/inbox.tsx",
      "content": "import { Button } from '@astrale-os/ui/button'\nexport function InboxBlock({\n  className,\n  style,\n  conversations,\n  selected,\n  loading,\n  onSelect,\n  onLoadMore,\n}: {\n  className?: string\n  style?: React.CSSProperties\n\n  conversations: readonly { id: string; sender: string; subject: string; unread?: boolean }[]\n  selected?: string\n  loading?: boolean\n  onSelect(id: string): void\n  onLoadMore(): void\n}) {\n  return (\n    <section\n      data-slot=\"block-communication-inbox\"\n      style={style}\n      aria-busy={loading}\n      className={className}\n    >\n      <header data-slot=\"blocks-communication-inbox-header\" className=\"flex justify-between\">\n        <h2 data-slot=\"blocks-communication-inbox-h2\" className=\"font-heading text-2xl\">\n          Inbox\n        </h2>\n        <Button variant=\"outline\" disabled={loading} onClick={onLoadMore}>\n          Load more\n        </Button>\n      </header>\n      <ol data-slot=\"blocks-communication-inbox-ol\" className=\"mt-4 divide-y rounded-xl border\">\n        {conversations.map((item) => (\n          <li data-slot=\"blocks-communication-inbox-li\" key={item.id}>\n            <Button\n              variant={item.id === selected ? 'secondary' : 'ghost'}\n              className=\"h-auto w-full justify-start p-4 text-left\"\n              onClick={() => onSelect(item.id)}\n            >\n              <span data-slot=\"blocks-communication-inbox-span\">\n                <strong\n                  data-slot=\"blocks-communication-inbox-strong\"\n                  className={item.unread ? '' : 'font-normal'}\n                >\n                  {item.sender}\n                </strong>\n                <span\n                  data-slot=\"blocks-communication-inbox-span\"\n                  className=\"block text-muted-foreground\"\n                >\n                  {item.subject}\n                </span>\n              </span>\n            </Button>\n          </li>\n        ))}\n      </ol>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/astrale/block/communication/inbox.tsx"
    }
  ],
  "meta": {
    "canonicalAddress": "block/communication/inbox",
    "ownership": "consumer-source"
  },
  "type": "registry:block"
}