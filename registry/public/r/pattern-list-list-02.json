  "files": [
    {
      "path": "source/patterns/list/list-02/list-02.tsx",
      "content": "import { Item, ItemActions, ItemContent, ItemDescription, ItemMedia, ItemTitle } from '@astrale-os/ui/item'\n\nimport { Switch } from '@astrale-os/ui/switch'\nimport { BellIcon, MailIcon, MessageSquareIcon, UserIcon } from \"lucide-react\"\n\nconst ListNotifications = () => {\n  return (\n    <div className='w-full max-w-sm space-y-4'>\n      <Item variant='outline'>\n        <ItemMedia variant='icon'>\n          <BellIcon\n          />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Push Notifications</ItemTitle>\n          <ItemDescription>Get notified on your device</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Switch />\n        </ItemActions>\n      </Item>\n      <Item variant='outline'>\n        <ItemMedia variant='icon'>\n          <MailIcon\n          />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Email Notifications</ItemTitle>\n          <ItemDescription>Receive updates via email</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Switch defaultChecked />\n        </ItemActions>\n      </Item>\n      <Item variant='outline'>\n        <ItemMedia variant='icon'>\n          <MessageSquareIcon\n          />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>SMS Notifications</ItemTitle>\n          <ItemDescription>Receive updates via SMS</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Switch defaultChecked />\n        </ItemActions>\n      </Item>\n      <Item variant='outline'>\n        <ItemMedia variant='icon'>\n          <UserIcon\n          />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Profile Visibility</ItemTitle>\n          <ItemDescription>Control who can see your profile</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Switch />\n        </ItemActions>\n      </Item>\n    </div>\n  )\n}\n\nexport default ListNotifications\n",
      "type": "registry:component",
      "target": "components/astrale/components/list/list-02.tsx"
    }
  ],
  "meta": {
    "canonicalAddress": "pattern/list/list-02",
