{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattern-list-list-02",
  "title": "List 2",
  "description": "Notification settings list using outlined Item cards with icon media, title, description, and a toggle Switch per row.",
  "dependencies": [
    "@astrale-os/ui@^0.3.0-beta.0",
    "lucide-react@1.32.0"
