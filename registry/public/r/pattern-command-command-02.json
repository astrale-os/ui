      "path": "source/patterns/command/command-02/command-02.tsx",
      "content": "import {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut\n} from '@astrale-os/ui/command'\nimport { HomeIcon, PanelsTopLeftIcon, BellIcon, PlusIcon, PencilIcon, LogOutIcon } from \"lucide-react\"\n\nconst CommandPagesActions = () => {\n  return (\n    <Command className='max-w-sm rounded-lg border'>\n      <CommandInput placeholder='Search pages or actions...' />\n      <CommandList>\n        <CommandEmpty>No results found.</CommandEmpty>\n        <CommandGroup heading='Pages'>\n          <CommandItem>\n            <HomeIcon\n            />\n            <span>Home</span>\n            <CommandShortcut>⌘H</CommandShortcut>\n          </CommandItem>\n          <CommandItem>\n            <PanelsTopLeftIcon\n            />\n            <span>Dashboard</span>\n            <CommandShortcut>⌘D</CommandShortcut>\n          </CommandItem>\n          <CommandItem>\n            <BellIcon\n            />\n            <span>Notifications</span>\n            <CommandShortcut>⌘N</CommandShortcut>\n          </CommandItem>\n        </CommandGroup>\n        <CommandSeparator />\n        <CommandGroup heading='Actions'>\n          <CommandItem>\n            <PlusIcon\n            />\n            <span>New Document</span>\n            <CommandShortcut>⌘T</CommandShortcut>\n          </CommandItem>\n          <CommandItem>\n            <PencilIcon\n            />\n            <span>Edit Profile</span>\n          </CommandItem>\n          <CommandItem>\n            <LogOutIcon\n            />\n            <span>Log Out</span>\n            <CommandShortcut>⌘Q</CommandShortcut>\n          </CommandItem>\n        </CommandGroup>\n      </CommandList>\n    </Command>\n  )\n}\n\nexport default CommandPagesActions\n",
      "type": "registry:component",
      "target": "components/astrale/components/command/command-02.tsx"
    }
  ],
