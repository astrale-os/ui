  "name": "component-context-menu-context-menu-09",
  "title": "Context Menu 9",
  "description": "Full-featured context menu combining shortcuts, nested submenus, checkbox toggles, radio group sorting, and destructive actions.",
  "dependencies": [
    "@astrale-os/ui@^0.3.0-beta.0",
