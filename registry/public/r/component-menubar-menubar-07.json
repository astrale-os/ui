{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "component-menubar-menubar-07",
  "title": "Menu Bar 7",
  "description": "Labeled section menubar with Recent and Favorites contact groups and Work and Personal group categories.",
