      "content": "import { Button } from '@astrale-os/ui/button'\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@astrale-os/ui/collapsible'\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuGroup,\n  DropdownMenuTrigger\n} from '@astrale-os/ui/dropdown-menu'\nimport { UserIcon, SettingsIcon, ChevronRightIcon, CircleSmallIcon, UsersIcon, LogOutIcon } from \"lucide-react\"\n\nconst CollapsibleDropdownMenuDemo = () => {\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger render={<Button variant='outline'>Dropdown with collapsible</Button>} />\n      <DropdownMenuContent className='w-56'>\n        <DropdownMenuItem>\n          <UserIcon\n          />\n          <span>Profile</span>\n        </DropdownMenuItem>\n        <Collapsible render={<DropdownMenuGroup></DropdownMenuGroup>}>\n          <CollapsibleTrigger\n            render={\n              <DropdownMenuItem closeOnClick={false} className='justify-between'>\n                <div className='flex items-center gap-2'>\n                  <SettingsIcon\n                  />\n                  <span>Settings</span>\n                </div>\n                <ChevronRightIcon className='shrink-0 transition-transform in-data-closed:rotate-0 in-data-open:rotate-90' />\n              </DropdownMenuItem>\n            }\n          />\n          <CollapsibleContent className='pl-4'>\n            <DropdownMenuItem>\n              <CircleSmallIcon\n              />\n              <span>Account</span>\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <CircleSmallIcon\n              />\n              <span>Security</span>\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <CircleSmallIcon\n              />\n              <span>Billing & plans</span>\n            </DropdownMenuItem>\n          </CollapsibleContent>\n        </Collapsible>\n        <Collapsible className='group' render={<DropdownMenuGroup></DropdownMenuGroup>}>\n          <DropdownMenuGroup>\n            <CollapsibleTrigger\n              render={\n                <DropdownMenuItem closeOnClick={false} className='justify-between'>\n                  <div className='flex items-center gap-2'>\n                    <UsersIcon\n                    />\n                    <span>Users</span>\n                  </div>\n                  <ChevronRightIcon className='shrink-0 transition-transform in-data-closed:rotate-0 in-data-open:rotate-90' />\n                </DropdownMenuItem>\n              }\n            />\n            <CollapsibleContent className='pl-4'>\n              <DropdownMenuItem>\n                <CircleSmallIcon\n                />\n                <span>Teams</span>\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <CircleSmallIcon\n                />\n                <span>Projects</span>\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <CircleSmallIcon\n                />\n                <span>Connections</span>\n              </DropdownMenuItem>\n            </CollapsibleContent>\n          </DropdownMenuGroup>\n        </Collapsible>\n        <DropdownMenuItem>\n          <LogOutIcon\n          />\n          <span>Log out</span>\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n\nexport default CollapsibleDropdownMenuDemo\n",
      "type": "registry:component",
      "target": "components/astrale/components/collapsible/collapsible-08.tsx"
    }
