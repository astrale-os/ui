  "name": "component-drawer-drawer-04",
  "title": "Drawer 4",
  "description": "Multi-direction drawer with four side trigger buttons (top, right, bottom, left) opening an edit profile form.",
  "dependencies": [
    "@astrale-os/ui@^0.3.0-beta.0"
