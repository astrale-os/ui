      "path": "source/patterns/command/command-01/command-01.tsx",
      "content": "import {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut\n} from '@astrale-os/ui/command'\nimport { CalendarIcon, SmileIcon, CalculatorIcon, UserIcon, CreditCardIcon, SettingsIcon } from \"lucide-react\"\n\nconst CommandDemo = () => {\n  return (\n    <Command className='max-w-sm rounded-lg border'>\n      <CommandInput placeholder='Type a command or search...' />\n      <CommandList>\n        <CommandEmpty>No results found.</CommandEmpty>\n        <CommandGroup heading='Suggestions'>\n          <CommandItem>\n            <CalendarIcon\n            />\n            <span>Calendar</span>\n          </CommandItem>\n          <CommandItem>\n            <SmileIcon\n            />\n            <span>Search Emoji</span>\n          </CommandItem>\n          <CommandItem disabled>\n            <CalculatorIcon\n            />\n            <span>Calculator</span>\n          </CommandItem>\n        </CommandGroup>\n        <CommandSeparator />\n        <CommandGroup heading='Settings'>\n          <CommandItem>\n            <UserIcon\n            />\n            <span>Profile</span>\n            <CommandShortcut>⌘P</CommandShortcut>\n          </CommandItem>\n          <CommandItem>\n            <CreditCardIcon\n            />\n            <span>Billing</span>\n            <CommandShortcut>⌘B</CommandShortcut>\n          </CommandItem>\n          <CommandItem>\n            <SettingsIcon\n            />\n            <span>Settings</span>\n            <CommandShortcut>⌘S</CommandShortcut>\n          </CommandItem>\n        </CommandGroup>\n      </CommandList>\n    </Command>\n  )\n}\n\nexport default CommandDemo\n",
      "type": "registry:component",
      "target": "components/astrale/pattern/command/command-01.tsx"
    }
  ],
