  ],
  "files": [
    {
      "path": "source/patterns/command/command-06/command-06.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { Button } from '@astrale-os/ui/button'\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut\n} from '@astrale-os/ui/command'\nimport { HomeIcon, InboxIcon, FileTextIcon, FolderIcon, PlusIcon, FolderPlusIcon, CopyIcon, ScissorsIcon, ClipboardPasteIcon, TrashIcon, LayoutGridIcon, ListIcon, ZoomInIcon, ZoomOutIcon, UserIcon, CreditCardIcon, SettingsIcon, BellIcon, HelpCircleIcon, CalculatorIcon, CalendarIcon, ImageIcon, CodeIcon } from \"lucide-react\"\n\nconst CommandScrollable = () => {\n  const [open, setOpen] = React.useState(false)\n\n  return (\n    <div className='flex flex-col gap-4'>\n      <Button onClick={() => setOpen(true)} variant='outline' className='w-fit'>\n        Scrollable Menu\n      </Button>\n      <CommandDialog open={open} onOpenChange={setOpen}>\n        <Command>\n          <CommandInput placeholder='Type a command or search...' />\n          <CommandList>\n            <CommandEmpty>No results found.</CommandEmpty>\n            <CommandGroup heading='Navigation'>\n              <CommandItem>\n                <HomeIcon\n                />\n                <span>Home</span>\n                <CommandShortcut>⌘H</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <InboxIcon\n                />\n                <span>Inbox</span>\n                <CommandShortcut>⌘I</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <FileTextIcon\n                />\n                <span>Documents</span>\n                <CommandShortcut>⌘D</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <FolderIcon\n                />\n                <span>Folders</span>\n                <CommandShortcut>⌘F</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading='Actions'>\n              <CommandItem>\n                <PlusIcon\n                />\n                <span>New File</span>\n                <CommandShortcut>⌘N</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <FolderPlusIcon\n                />\n                <span>New Folder</span>\n                <CommandShortcut>⇧⌘N</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <CopyIcon\n                />\n                <span>Copy</span>\n                <CommandShortcut>⌘C</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <ScissorsIcon\n                />\n                <span>Cut</span>\n                <CommandShortcut>⌘X</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <ClipboardPasteIcon\n                />\n                <span>Paste</span>\n                <CommandShortcut>⌘V</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <TrashIcon\n                />\n                <span>Delete</span>\n                <CommandShortcut>⌫</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading='View'>\n              <CommandItem>\n                <LayoutGridIcon\n                />\n                <span>Grid View</span>\n              </CommandItem>\n              <CommandItem>\n                <ListIcon\n                />\n                <span>List View</span>\n              </CommandItem>\n              <CommandItem>\n                <ZoomInIcon\n                />\n                <span>Zoom In</span>\n                <CommandShortcut>⌘+</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <ZoomOutIcon\n                />\n                <span>Zoom Out</span>\n                <CommandShortcut>⌘-</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading='Account'>\n              <CommandItem>\n                <UserIcon\n                />\n                <span>Profile</span>\n                <CommandShortcut>⌘P</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <CreditCardIcon\n                />\n                <span>Billing</span>\n                <CommandShortcut>⌘B</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <SettingsIcon\n                />\n                <span>Settings</span>\n                <CommandShortcut>⌘S</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <BellIcon\n                />\n                <span>Notifications</span>\n              </CommandItem>\n              <CommandItem>\n                <HelpCircleIcon\n                />\n                <span>Help & Support</span>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading='Tools'>\n              <CommandItem>\n                <CalculatorIcon\n                />\n                <span>Calculator</span>\n              </CommandItem>\n              <CommandItem>\n                <CalendarIcon\n                />\n                <span>Calendar</span>\n              </CommandItem>\n              <CommandItem>\n                <ImageIcon\n                />\n                <span>Image Editor</span>\n              </CommandItem>\n              <CommandItem>\n                <CodeIcon\n                />\n                <span>Code Editor</span>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </CommandDialog>\n    </div>\n  )\n}\n\nexport default CommandScrollable\n",
      "type": "registry:component",
      "target": "components/astrale/components/command/command-06.tsx"
    }
  ],
