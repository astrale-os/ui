  "name": "component-popover-popover-02",
  "title": "Popover 2",
  "description": "A dimensions popover with input fields for width, max width, height, and max height settings",
  "dependencies": [
    "@astrale-os/ui@^0.3.0-beta.0",
    "lucide-react@1.32.0"
