      "path": "source/patterns/breadcrumb/breadcrumb-07/breadcrumb-07.tsx",
      "content": "'use client'\n\nimport { useState } from 'react'\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator\n} from '@astrale-os/ui/breadcrumb'\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger\n} from '@astrale-os/ui/dropdown-menu'\nimport { HomeIcon, ChevronsRightIcon, FolderOpenIcon, FolderIcon } from \"lucide-react\"\n\nconst BreadcrumbWithIconDemo = () => {\n  const [open, setOpen] = useState(false)\n\n  return (\n    <Breadcrumb>\n      <BreadcrumbList>\n        <BreadcrumbItem>\n          <BreadcrumbLink href='#'>\n            <HomeIcon className='size-4' />\n            <span className='sr-only'>Home</span>\n          </BreadcrumbLink>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator>\n          <ChevronsRightIcon\n          />\n        </BreadcrumbSeparator>\n        <BreadcrumbItem>\n          <DropdownMenu open={open} onOpenChange={setOpen}>\n            <DropdownMenuTrigger className='flex cursor-pointer items-center gap-1'>\n              {open ? (\n                <FolderOpenIcon className='size-4' />\n              ) : (\n                <FolderIcon className='size-4' />\n              )}\n              <span className='sr-only'>{open ? 'Open' : 'Close'}</span>\n            </DropdownMenuTrigger>\n            <DropdownMenuContent>\n              <DropdownMenuItem>Documentation</DropdownMenuItem>\n              <DropdownMenuItem>Themes</DropdownMenuItem>\n              <DropdownMenuItem>GitHub</DropdownMenuItem>\n            </DropdownMenuContent>\n          </DropdownMenu>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator>\n          <ChevronsRightIcon\n          />\n        </BreadcrumbSeparator>\n        <BreadcrumbItem>\n          <BreadcrumbPage>Add Document</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n  )\n}\n\nexport default BreadcrumbWithIconDemo\n",
      "type": "registry:component",
      "target": "components/astrale/components/breadcrumb/breadcrumb-07.tsx"
    }
  ],
