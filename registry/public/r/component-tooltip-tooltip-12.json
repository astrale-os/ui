      "content": "import { Avatar, AvatarFallback, AvatarImage } from '@astrale-os/ui/avatar'\nimport { Button } from '@astrale-os/ui/button'\nimport { HoverCard, HoverCardContent, HoverCardTrigger } from '@astrale-os/ui/hover-card'\n\nconst HoverCardStatsDemo = () => {\n  return (\n    <HoverCard>\n      <HoverCardTrigger delay={0} closeDelay={0} render={<Button variant='link'>Hover Card Stats</Button>} />\n      <HoverCardContent className='w-fit'>\n        <div className='flex items-center gap-1.5'>\n          <div className='flex flex-col gap-1'>\n            <div className='text-sm font-medium'>Total page views</div>\n            <div className='text-xl font-semibold'>89,400</div>\n            <div className='text-muted-foreground text-xs'>21% ↗︎ than last month</div>\n          </div>\n          <Avatar className='size-10'>\n            <AvatarImage src='https://cdn.shadcnstudio.com/ss-assets/avatar/avatar-5.png' alt='Hallie Richards' />\n            <AvatarFallback className='text-xs'>HR</AvatarFallback>\n          </Avatar>\n        </div>\n      </HoverCardContent>\n    </HoverCard>\n  )\n}\n\nexport default HoverCardStatsDemo\n",
