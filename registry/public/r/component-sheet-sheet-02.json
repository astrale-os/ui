      "content": "import { Button } from '@astrale-os/ui/button'\nimport { Input } from '@astrale-os/ui/input'\nimport { Label } from '@astrale-os/ui/label'\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger\n} from '@astrale-os/ui/sheet'\n\nconst SheetSidesDemo = () => {\n  return (\n    <div className='flex flex-wrap gap-2'>\n      <Sheet>\n        <SheetTrigger render={<Button variant='outline' />}>Top</SheetTrigger>\n        <SheetContent side='top'>\n          <SheetHeader>\n            <SheetTitle>Edit profile</SheetTitle>\n            <SheetDescription>Make changes to your profile here. Click save when you&apos;re done.</SheetDescription>\n          </SheetHeader>\n          <div className='grid flex-1 auto-rows-min gap-6 px-4'>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-name'>Name</Label>\n              <Input id='sheet-demo-name' defaultValue='Pedro Duarte' />\n            </div>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-username'>Username</Label>\n              <Input id='sheet-demo-username' defaultValue='@peduarte' />\n            </div>\n          </div>\n          <SheetFooter>\n            <Button type='submit'>Save changes</Button>\n            <SheetClose render={<Button variant='outline' />}>Close</SheetClose>\n          </SheetFooter>\n        </SheetContent>\n      </Sheet>\n      <Sheet>\n        <SheetTrigger render={<Button variant='outline' />}>Right</SheetTrigger>\n        <SheetContent side='right'>\n          <SheetHeader>\n            <SheetTitle>Edit profile</SheetTitle>\n            <SheetDescription>Make changes to your profile here. Click save when you&apos;re done.</SheetDescription>\n          </SheetHeader>\n          <div className='grid flex-1 auto-rows-min gap-6 px-4'>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-name'>Name</Label>\n              <Input id='sheet-demo-name' defaultValue='Pedro Duarte' />\n            </div>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-username'>Username</Label>\n              <Input id='sheet-demo-username' defaultValue='@peduarte' />\n            </div>\n          </div>\n          <SheetFooter>\n            <Button type='submit'>Save changes</Button>\n            <SheetClose render={<Button variant='outline' />}>Close</SheetClose>\n          </SheetFooter>\n        </SheetContent>\n      </Sheet>\n      <Sheet>\n        <SheetTrigger render={<Button variant='outline' />}>Bottom</SheetTrigger>\n        <SheetContent side='bottom'>\n          <SheetHeader>\n            <SheetTitle>Edit profile</SheetTitle>\n            <SheetDescription>Make changes to your profile here. Click save when you&apos;re done.</SheetDescription>\n          </SheetHeader>\n          <div className='grid flex-1 auto-rows-min gap-6 px-4'>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-name'>Name</Label>\n              <Input id='sheet-demo-name' defaultValue='Pedro Duarte' />\n            </div>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-username'>Username</Label>\n              <Input id='sheet-demo-username' defaultValue='@peduarte' />\n            </div>\n          </div>\n          <SheetFooter>\n            <Button type='submit'>Save changes</Button>\n            <SheetClose render={<Button variant='outline' />}>Close</SheetClose>\n          </SheetFooter>\n        </SheetContent>\n      </Sheet>\n      <Sheet>\n        <SheetTrigger render={<Button variant='outline' />}>Left</SheetTrigger>\n        <SheetContent side='left'>\n          <SheetHeader>\n            <SheetTitle>Edit profile</SheetTitle>\n            <SheetDescription>Make changes to your profile here. Click save when you&apos;re done.</SheetDescription>\n          </SheetHeader>\n          <div className='grid flex-1 auto-rows-min gap-6 px-4'>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-name'>Name</Label>\n              <Input id='sheet-demo-name' defaultValue='Pedro Duarte' />\n            </div>\n            <div className='grid gap-3'>\n              <Label htmlFor='sheet-demo-username'>Username</Label>\n              <Input id='sheet-demo-username' defaultValue='@peduarte' />\n            </div>\n          </div>\n          <SheetFooter>\n            <Button type='submit'>Save changes</Button>\n            <SheetClose render={<Button variant='outline' />}>Close</SheetClose>\n          </SheetFooter>\n        </SheetContent>\n      </Sheet>\n    </div>\n  )\n}\n\nexport default SheetSidesDemo\n",
