      "path": "source/patterns/command/command-03/command-03.tsx",
      "content": "import {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut\n} from '@astrale-os/ui/command'\nimport { FolderOpenIcon, GitBranchIcon, StarIcon, TagIcon, CopyIcon, Share2Icon } from \"lucide-react\"\n\nconst CommandRepoOps = () => {\n  return (\n    <Command className='max-w-sm rounded-lg border'>\n      <CommandInput placeholder='Switch Repository or operations...' />\n      <CommandList>\n        <CommandEmpty>No results found.</CommandEmpty>\n        <CommandGroup heading='Repositories'>\n          <CommandItem>\n            <FolderOpenIcon\n            />\n            <span>design-system</span>\n          </CommandItem>\n          <CommandItem>\n            <GitBranchIcon\n            />\n            <span>feature/dashboard-v2</span>\n          </CommandItem>\n          <CommandItem>\n            <StarIcon\n            />\n            <span>StarIconred Projects</span>\n            <CommandShortcut>⌘S</CommandShortcut>\n          </CommandItem>\n        </CommandGroup>\n        <CommandSeparator />\n        <CommandGroup heading='Operations'>\n          <CommandItem>\n            <TagIcon\n            />\n            <span>Create Release TagIcon</span>\n          </CommandItem>\n          <CommandItem>\n            <CopyIcon\n            />\n            <span>Duplicate Project</span>\n            <CommandShortcut>⌘D</CommandShortcut>\n          </CommandItem>\n          <CommandItem>\n            <Share2Icon\n            />\n            <span>Share Link</span>\n            <CommandShortcut>⌘L</CommandShortcut>\n          </CommandItem>\n        </CommandGroup>\n      </CommandList>\n    </Command>\n  )\n}\n\nexport default CommandRepoOps\n",
      "type": "registry:component",
      "target": "components/astrale/components/command/command-03.tsx"
    }
  ],
