{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "astrale-variants-patterns-code-block",
  "homepage": "https://github.com/astrale-os/ui",
  "items": [
    {
      "name": "pattern-code-block-code-block-01",
      "type": "registry:block",
      "title": "Code Block 1",
      "description": "TSX demo: single-file code block with Shiki syntax highlighting and copy-to-clipboard",
      "dependencies": [
        "@astrale-os/ui@^0.3.0-beta.0",
        "lucide-react@1.32.0",
        "react@19.2.8",
        "shiki@^4.4.3"
      ],
      "files": [
        {
          "path": "code-block-01.tsx",
          "type": "registry:component",
          "target": "components/astrale/components/code-block/code-block-01.tsx"
        },
        {
          "path": "support/components/ui/code-block.tsx",
          "type": "registry:component",
          "target": "components/ui/code-block.tsx"
        }
      ],
      "css": {
        ".dark .shiki, .dark .shiki span": {
          "background-color": "transparent !important",
          "color": "var(--shiki-dark) !important",
          "font-style": "var(--shiki-dark-font-style) !important",
          "font-weight": "var(--shiki-dark-font-weight) !important",
          "text-decoration": "var(--shiki-dark-text-decoration) !important"
        }
      },
      "meta": {
        "canonicalAddress": "pattern/code-block/code-block-01",
        "provider": "@astrale-os/ui",
        "source": "@astrale-os/ui",
        "license": "MIT"
      }
    },
