{
  "$schema": "https://raw.githubusercontent.com/astrale-os/ui/main/schemas/theme.schema.json",
  "version": 8,
  "name": "console",
  "label": "Console",
  "description": "Shell, Issues, and Admin: Geist on neutral paper, ink primary, indigo accent, and hairline elevation.",
  "appearance": {
    "light": {
      "background": "#f6f6f8",
      "foreground": "#121418",
      "card": "#ffffff",
      "cardForeground": "#121418",
      "popover": "#ffffff",
      "popoverForeground": "#121418",
