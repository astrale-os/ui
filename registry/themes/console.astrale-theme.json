      "chart4": "#e5674f",
      "chart5": "#8a62d6",
      "sidebar": "#f6f6f8",
      "sidebarForeground": "#2f333b",
      "sidebarPrimary": "#121418",
      "sidebarPrimaryForeground": "#ffffff",
      "sidebarAccent": "#ffffff",
