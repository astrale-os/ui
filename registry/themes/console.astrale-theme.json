      "popover": "#22232a",
      "popoverForeground": "#eceef3",
      "primary": "#eceef3",
      "primaryForeground": "#1a1b20",
      "secondary": "#26272e",
      "secondaryForeground": "#c3c7d1",
      "muted": "#26272e",
      "mutedForeground": "#9a9fac",
      "accent": "#31344a",
      "accentForeground": "#b4bdff",
      "destructive": "#f49a96",
      "destructiveForeground": "#1a1b20",
      "success": "#3fbf8a",
      "successForeground": "#1a1b20",
      "info": "#9eaaff",
      "infoForeground": "#1a1b20",
      "warning": "#e0a443",
      "warningForeground": "#1a1b20",
      "border": "rgb(255 255 255 / 0.07)",
      "input": "rgb(255 255 255 / 0.12)",
      "ring": "rgb(142 155 255 / 0.6)",
      "chart1": "#7c9bf0",
