      "chart3": "#e7a54a",
      "chart4": "#f08a74",
      "chart5": "#a98ae6",
      "sidebar": "#1a1b20",
      "sidebarForeground": "#c3c7d1",
      "sidebarPrimary": "#eceef3",
      "sidebarPrimaryForeground": "#1a1b20",
      "sidebarAccent": "#26272e",
      "sidebarAccentForeground": "#eceef3",
      "sidebarBorder": "rgb(255 255 255 / 0.07)",
      "sidebarRing": "rgb(142 155 255 / 0.6)"
    }
  },
  "typography": {
    "body": {
      "family": "'Geist', 'Geist Variable', ui-sans-serif, system-ui, sans-serif",
      "tracking": "0",
      "leading": "1.5",
      "weight": 400
    },
    "heading": {
      "family": "'Geist', 'Geist Variable', ui-sans-serif, system-ui, sans-serif",
      "tracking": "-0.01em",
      "leading": "1.25",
      "weight": 600
    },
    "label": {
      "weight": 500
    },
    "mono": "'Geist Mono', 'Geist Mono Variable', ui-monospace, 'SFMono-Regular', Menlo, monospace"
  },
  "geometry": {
    "radius": "0.5rem",
    "panelRadius": "0.875rem",
    "actionRadius": null
  },
  "density": {
    "control": "2.25rem",
    "controlSmall": "2rem",
    "controlLarge": "2.5rem",
    "controlPadding": "0.625rem",
    "panelSpacing": "1rem"
  },
  "effects": {
    "light": {
      "controlShadow": "0 1px 2px rgb(0 0 0 / 0.04)",
      "panelShadow": "0 0 0 0.5px rgb(17 22 40 / 0.08), 0 8px 24px -4px rgb(17 22 40 / 0.14), 0 30px 60px -20px rgb(17 22 40 / 0.22)",
      "overlayShadow": "0 0 0 0.5px rgb(17 22 40 / 0.08), 0 8px 24px -4px rgb(17 22 40 / 0.14)",
      "backdrop": "rgb(17 22 40 / 0.24)"
    },
    "dark": {
      "controlShadow": "0 1px 2px rgb(0 0 0 / 0.3)",
      "panelShadow": "0 0 0 0.5px rgb(255 255 255 / 0.1), 0 8px 24px -4px rgb(0 0 0 / 0.45), 0 30px 60px -20px rgb(0 0 0 / 0.6)",
      "overlayShadow": "0 0 0 0.5px rgb(255 255 255 / 0.1), 0 8px 24px -4px rgb(0 0 0 / 0.45)",
      "backdrop": "rgb(0 0 0 / 0.5)"
    }
  },
  "motion": {
    "fast": "120ms",
    "standard": "180ms"
  }
}
