{
  "name": "@astrale-os/ui-workspace",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/ui.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"try{require('./.check-workspace.cjs')}catch{}\"",
    "build": "pnpm -r run build && node scripts/verify-no-source-maps.mjs constants/dist utils/dist preset/dist components/dist ui/dist",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "test": "node --test scripts/*.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrale/commitlint-config": "jsr:@astrale/commitlint-config@~2.0.0",
    "@astrale/typescript-config": "jsr:@astrale/typescript-config@~1.1.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "~9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{js,cjs,mjs}": [
      "oxfmt --write"
    ],
    "*.{json,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "packageManager": "pnpm@11.13.1"
}
