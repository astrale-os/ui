{
  "name": "@astrale-os/ui-workspace",
  "version": "0.3.0-beta.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/ui.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @astrale-os/ui build && node scripts/verify-no-source-maps.mjs packages/ui/dist",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "test": "pnpm run test:contracts && pnpm run test:components",
    "test:contracts": "node --test scripts/*.test.mjs",
    "test:components": "pnpm --filter @astrale-os/ui test",
    "test:registry-behavior": "pnpm --filter @astrale-os/ui-registry-workspace test",
    "test:security": "node scripts/security-policy.mjs",
    "registry:typecheck": "tsc -p registry/tsconfig.json",
    "registry:index": "node scripts/build-registry-index.mjs",
    "registry:slots": "node scripts/normalize-registry-slots.mjs",
    "intake:ledger": "node scripts/refresh-upstream-ledger.mjs",
    "registry:build": "pnpm registry:index && pnpm dlx shadcn@4.18.0 build registry.json -o registry/public/r",
    "registry:check": "pnpm registry:index && pnpm registry:typecheck && node --test scripts/registry-contract.test.mjs",
    "registry:qualify": "node scripts/qualify-registry.mjs",
    "catalog:typecheck": "pnpm --filter @astrale-os/ui-catalog typecheck",
    "catalog:build": "pnpm --filter @astrale-os/ui-catalog build",
    "catalog:test": "pnpm --filter @astrale-os/ui-catalog test:e2e",
    "package:qualify": "node scripts/qualify-package.mjs",
    "qualify:publication": "node scripts/qualify-publication.mjs",
    "check": "pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm registry:check && pnpm catalog:typecheck",
    "qualify": "pnpm check && pnpm test:components && pnpm test:registry-behavior && pnpm test:security && pnpm build && pnpm registry:build && pnpm package:qualify && pnpm registry:qualify && pnpm catalog:build && pnpm catalog:test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrale/commitlint-config": "jsr:@astrale/commitlint-config@~2.0.0",
    "@astrale/typescript-config": "jsr:@astrale/typescript-config@~1.1.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "~9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{js,cjs,mjs}": [
      "oxfmt --write"
    ],
    "*.{json,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "packageManager": "pnpm@11.13.1"
}
