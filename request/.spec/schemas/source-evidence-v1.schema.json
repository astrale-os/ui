{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.astrale.ai/ui/request/source-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "path"],
        "properties": {
          "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "path": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
