{
  "name": "@astrale-os/ui-preset",
  "version": "1.1.0",
  "description": "Astrale Tailwind CSS preset - Theme configuration and custom utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrale-os/ui.git",
    "directory": "preset"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://npm.pkg.github.com",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsgo",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit",
    "preinstall": "node .check-workspace.cjs"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "tailwindcss": "^4.0.6",
    "typescript": "~6.0.1-rc"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
