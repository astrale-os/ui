{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/astrale-os/ui/main/schemas/theme.schema.json",
  "title": "Astrale portable theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "name",
    "label",
    "description",
    "appearance",
    "typography",
    "geometry",
    "density",
    "effects",
    "motion"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/astrale-os/ui/main/schemas/theme.schema.json"
    },
    "version": { "const": 5 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^{}<>\\\\\\n\\r]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[^{}<>\\\\\\n\\r]*$"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/mode" },
        "dark": { "$ref": "#/$defs/mode" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "heading", "mono"],
      "properties": {
        "body": { "$ref": "#/$defs/typographyRole" },
        "heading": { "$ref": "#/$defs/typographyRole" },
        "mono": { "$ref": "#/$defs/font" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius", "panelRadius"],
      "properties": {
        "radius": { "$ref": "#/$defs/length" },
        "panelRadius": { "$ref": "#/$defs/length" }
      }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "controlSmall", "controlLarge"],
      "properties": {
        "control": { "$ref": "#/$defs/length" },
        "controlSmall": { "$ref": "#/$defs/length" },
        "controlLarge": { "$ref": "#/$defs/length" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlShadow", "panelShadow"],
      "properties": {
        "controlShadow": { "$ref": "#/$defs/cssValue" },
        "panelShadow": { "$ref": "#/$defs/cssValue" }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "standard"],
      "properties": {
        "fast": { "$ref": "#/$defs/duration" },
        "standard": { "$ref": "#/$defs/duration" }
      }
    },
    "generation": { "$ref": "#/$defs/generatorMetadata" }
  },
  "$defs": {
    "color": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120,
      "pattern": "^(?!.*\\/\\*)(?!.*\\*\\/)(?:(?:oklch|rgb|rgba|hsl|hsla)\\(\\s*[+-]?(?:[0-9]|\\.)[0-9+.%degarturn,/\\s-]*\\)|#[0-9A-Fa-f]{3,8})$"
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "foreground",
        "card",
        "cardForeground",
        "popover",
        "popoverForeground",
        "primary",
        "primaryForeground",
        "secondary",
        "secondaryForeground",
        "muted",
        "mutedForeground",
        "accent",
        "accentForeground",
        "destructive",
        "destructiveForeground",
        "border",
        "input",
        "ring",
        "chart1",
        "chart2",
        "chart3",
        "chart4",
        "chart5",
        "sidebar",
        "sidebarForeground",
        "sidebarPrimary",
        "sidebarPrimaryForeground",
        "sidebarAccent",
        "sidebarAccentForeground",
        "sidebarBorder",
        "sidebarRing"
      ],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "foreground": { "$ref": "#/$defs/color" },
        "card": { "$ref": "#/$defs/color" },
        "cardForeground": { "$ref": "#/$defs/color" },
        "popover": { "$ref": "#/$defs/color" },
        "popoverForeground": { "$ref": "#/$defs/color" },
        "primary": { "$ref": "#/$defs/color" },
        "primaryForeground": { "$ref": "#/$defs/color" },
        "secondary": { "$ref": "#/$defs/color" },
        "secondaryForeground": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "mutedForeground": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "accentForeground": { "$ref": "#/$defs/color" },
        "destructive": { "$ref": "#/$defs/color" },
        "destructiveForeground": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "input": { "$ref": "#/$defs/color" },
        "ring": { "$ref": "#/$defs/color" },
        "chart1": { "$ref": "#/$defs/color" },
        "chart2": { "$ref": "#/$defs/color" },
        "chart3": { "$ref": "#/$defs/color" },
        "chart4": { "$ref": "#/$defs/color" },
        "chart5": { "$ref": "#/$defs/color" },
        "sidebar": { "$ref": "#/$defs/color" },
        "sidebarForeground": { "$ref": "#/$defs/color" },
        "sidebarPrimary": { "$ref": "#/$defs/color" },
        "sidebarPrimaryForeground": { "$ref": "#/$defs/color" },
        "sidebarAccent": { "$ref": "#/$defs/color" },
        "sidebarAccentForeground": { "$ref": "#/$defs/color" },
        "sidebarBorder": { "$ref": "#/$defs/color" },
        "sidebarRing": { "$ref": "#/$defs/color" }
      }
    },
    "font": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*\\/\\*)(?!.*\\*\\/)[^{};\\\\\\n\\r]{1,240}$"
    },
    "typographyRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "tracking", "leading", "weight"],
      "properties": {
        "family": { "$ref": "#/$defs/font" },
        "tracking": { "$ref": "#/$defs/tracking" },
        "leading": { "$ref": "#/$defs/leading" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 }
      }
    },
    "tracking": {
      "type": "string",
      "pattern": "^(?:0|-?0\\.(?:0(?:[0-3][0-9]*|40*)?)em)$"
    },
    "leading": {
      "type": "string",
      "pattern": "^(?:1(?:\\.[0-9]+)?|2(?:\\.0+)?)$"
    },
    "length": {
      "type": "string",
      "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?(?:px|rem|em))$"
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?m?s)$"
    },
    "cssValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*\\/\\*)(?!.*\\*\\/)(?:none|(?:inset\\s+)?-?(?:0|[0-9]+(?:\\.[0-9]+)?(?:px|rem|em))(?:\\s|$)[^{};\\\\]+)$"
    },
    "generatorBranch": {
      "enum": ["palette", "typography", "geometry"]
    },
    "generatorSeed": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "generatorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "engineVersion",
        "fontCatalogVersion",
        "seed",
        "derivationSeeds",
        "dna",
        "locks",
        "editedBranches",
        "lineage"
      ],
      "properties": {
        "kind": { "const": "astrale.theme-generation" },
        "version": { "const": 1 },
        "engineVersion": { "const": 2 },
        "fontCatalogVersion": { "const": 1 },
        "seed": { "$ref": "#/$defs/generatorSeed" },
        "derivationSeeds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["palette", "typography", "geometry"],
          "properties": {
            "palette": { "$ref": "#/$defs/generatorSeed" },
            "typography": { "$ref": "#/$defs/generatorSeed" },
            "geometry": { "$ref": "#/$defs/generatorSeed" }
          }
        },
        "dna": { "$ref": "#/$defs/themeDNA" },
        "locks": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generatorBranch" }
        },
        "editedBranches": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generatorBranch" }
        },
        "lineage": { "$ref": "#/$defs/generatorLineage" }
      }
    },
    "themeDNA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "typography", "geometry"],
      "properties": {
        "palette": { "$ref": "#/$defs/paletteDNA" },
        "typography": { "$ref": "#/$defs/typographyDNA" },
        "geometry": { "$ref": "#/$defs/geometryDNA" }
      }
    },
    "paletteDNA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "relation", "colorfulness", "contrast", "tint", "warmth"],
      "properties": {
        "hue": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "relation": { "enum": ["tonal", "analogous", "complementary", "split"] },
        "colorfulness": { "type": "number", "minimum": 0, "maximum": 1 },
        "contrast": { "type": "number", "minimum": 0, "maximum": 1 },
        "tint": { "type": "number", "minimum": 0, "maximum": 1 },
        "warmth": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "typographyDNA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrast", "compactness"],
      "properties": {
        "contrast": { "type": "number", "minimum": 0, "maximum": 1 },
        "compactness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "geometryDNA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["density", "roundness", "elevation"],
      "properties": {
        "density": { "type": "number", "minimum": 0, "maximum": 1 },
        "roundness": { "type": "number", "minimum": 0, "maximum": 1 },
        "elevation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "generatorLineage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "new-direction" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parentSeed"],
          "properties": {
            "kind": { "const": "variation" },
            "parentSeed": { "$ref": "#/$defs/generatorSeed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failedAttempts"],
          "properties": {
            "kind": { "const": "fallback" },
            "failedAttempts": { "const": 12 }
          }
        }
      ]
    }
  }
}
