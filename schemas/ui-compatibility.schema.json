{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.astrale.ai/ui/compatibility/1",
  "title": "AstraleUiCompatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "shadcn", "base", "style", "baseUi", "react", "tailwind", "presets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "shadcn": { "type": "string", "minLength": 1 },
    "base": { "const": "base" },
    "style": { "const": "nova" },
    "baseUi": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "react": { "type": "string", "minLength": 1 },
    "tailwind": { "type": "string", "minLength": 1 },
    "presets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
