{
  "name": "@astrale-os/ui-components",
  "version": "0.1.0",
  "description": "Astrale UI Components - React components built on Shadcn patterns",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrale-os/ui.git",
    "directory": "components"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button.tsx",
      "import": "./src/button.tsx"
    },
    "./input": {
      "types": "./src/input.tsx",
      "import": "./src/input.tsx"
    },
    "./card": {
      "types": "./src/card.tsx",
      "import": "./src/card.tsx"
    },
    "./badge": {
      "types": "./src/badge.tsx",
      "import": "./src/badge.tsx"
    },
    "./select": {
      "types": "./src/select.tsx",
      "import": "./src/select.tsx"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "preinstall": "node .check-workspace.cjs"
  },
  "dependencies": {
    "@astrale-os/ui-utils": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./button": {
        "types": "./dist/button.d.ts",
        "import": "./dist/button.js"
      },
      "./input": {
        "types": "./dist/input.d.ts",
        "import": "./dist/input.js"
      },
      "./card": {
        "types": "./dist/card.d.ts",
        "import": "./dist/card.js"
      },
      "./badge": {
        "types": "./dist/badge.d.ts",
        "import": "./dist/badge.js"
      },
      "./select": {
        "types": "./dist/select.d.ts",
        "import": "./dist/select.js"
      }
    }
  }
}
